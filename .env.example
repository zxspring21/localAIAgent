# Application
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

# vLLM Backend
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_DEFAULT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
VLLM_API_KEY=vllm_not_needed

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://localai:localai@localhost:5432/localai

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=user_memory

# Embedding (optional - uses vLLM or OpenAI compatible endpoint)
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_MODEL=text-embedding-3-small

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Memory limits
ST_MEMORY_MAX_MESSAGES=20
LT_MEMORY_RETRIEVAL_LIMIT=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Web Search — provider: tavily | serpapi | duckduckgo
# Tavily: https://tavily.com  |  SerpAPI: https://serpapi.com
TAVILY_API_KEY=
SERPAPI_API_KEY=
WEB_SEARCH_PROVIDER=duckduckgo

# Frontend URL (shown in backend landing page)
FRONTEND_URL=http://localhost:3000
