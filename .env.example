# Application
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

# LLM Backend — use mlx on Apple Silicon Mac (M1/M2/M3/M4)
LLM_BACKEND=mlx
LLM_BASE_URL=http://localhost:8000/v1
LLM_DEFAULT_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
LLM_API_KEY=mlx
LLM_ENABLE_TOOLS=false
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048

# Legacy aliases (optional)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_DEFAULT_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
VLLM_API_KEY=mlx

# For NVIDIA GPU servers use vllm instead:
# LLM_BACKEND=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_ENABLE_TOOLS=true
# ./scripts/start_vllm.sh

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://localai:localai@localhost:5432/localai

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=user_memory

# Embedding (optional - uses vLLM or OpenAI compatible endpoint)
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_MODEL=text-embedding-3-small

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Memory limits
ST_MEMORY_MAX_MESSAGES=20
LT_MEMORY_RETRIEVAL_LIMIT=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Web Search — provider: tavily | serpapi | duckduckgo
# Tavily: https://tavily.com  |  SerpAPI: https://serpapi.com
TAVILY_API_KEY=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
SERPAPI_API_KEY=5ce0aa3cfbef9c6d0a2eb85595596437a35501cc4a373c0cbcd71a08ca036216
WEB_SEARCH_PROVIDER=duckduckgo

# Frontend URL (shown in backend landing page)
FRONTEND_URL=http://localhost:3000
