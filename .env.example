# Application
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

# LLM Backend — use mlx on Apple Silicon Mac (M1/M2/M3/M4)
LLM_BACKEND=mlx
LLM_BASE_URL=http://localhost:8000/v1
LLM_DEFAULT_MODEL=mlx-llama-3.2-3b
LLM_API_KEY=mlx
LLM_ENABLE_TOOLS=false
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048

# Repetition control (fixes MLX token loops)
LLM_REPETITION_PENALTY=1.15
LLM_REPETITION_CONTEXT_SIZE=40
LLM_FREQUENCY_PENALTY=0.3
LLM_PRESENCE_PENALTY=0.2
LLM_TEMPERATURE=0.7

# Answer validation (RAG + web search cross-check)
ANSWER_VALIDATION_ENABLED=true
VALIDATION_USE_WEB_SEARCH=true

# Legacy aliases (optional — auto-mapped to catalog ids)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_DEFAULT_MODEL=mlx-llama-3.2-3b
VLLM_API_KEY=mlx

# For NVIDIA GPU servers use vllm instead:
# LLM_BACKEND=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_ENABLE_TOOLS=true
# ./scripts/start_vllm.sh

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://localai:localai@localhost:5432/localai

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=user_memory
QDRANT_RAG_COLLECTION=user_documents

# Embedding (optional - uses MLX or OpenAI compatible endpoint)
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_MODEL=text-embedding-3-small

# RAG
RAG_ENABLED=true
RAG_RETRIEVAL_LIMIT=5

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Memory limits
ST_MEMORY_MAX_MESSAGES=20
LT_MEMORY_RETRIEVAL_LIMIT=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Web Search — provider: tavily | serpapi | duckduckgo
TAVILY_API_KEY=
SERPAPI_API_KEY=
WEB_SEARCH_PROVIDER=duckduckgo

# Cloud LLM API keys (optional — enables cloud models in catalog)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=

# MCP server URLs (optional integrations)
# Tavily MCP is auto-built from TAVILY_API_KEY when set
MCP_SLACK_URL=
MCP_NOTION_URL=
MCP_GMAIL_URL=
MCP_FACEBOOK_URL=

# Frontend URL (shown in backend landing page)
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Multi-account OAuth (web + Expo)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=

# Per-run sandbox (torn down when the agent finishes)
SANDBOX_ENABLED=true
AGENT_SANDBOX_ROOT=
